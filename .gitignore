# Data & runtime state (never committed)
data/
state/
snapshots/
*.db
*.db-journal
*.db-wal
*.db-shm
# ...but test fixture databases are committed data
!tests/fixtures/*.db

# YouTube cookies are live credentials (NFR-5)
cookies*
*cookies*
www.youtube.com_cookies*
!docs/tasks/cookies.md

# Local env file: docker compose auto-loads it; may hold secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
*.swp

# Meta cache (Story 2.2) and ignore lists hold derived data
data/meta/
transcripts/

# Session tooling (agent plans, local-only)
.zcode/
.serena/

# Task notes / epics / runbooks are local-only (purged from git history 2026-10-24)
docs/tasks/*
